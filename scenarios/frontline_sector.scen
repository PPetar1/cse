# German reserve, held back to exploit whichever Panzer division breaks
# through first.
[[units]]
name = "3rd Panzer Division"
toe = "GE_pz_div_41"
faction = "AX"
location = "GE Reserve"
morale = 85
experience = 75
leader = "Erich von Manstein"

# Airfield: based on-map at the German supply source/Rear supply depot, in
# range (9 hexes) of the frontline. mp = 0, so it never moves on its own.
[[units]]
name = "3rd Stuka Wing"
toe = "GE_stuka_wing"
faction = "AX"
location = { x = 4, y = 7 }
morale = 85
experience = 75

# Leaders: no gameplay effect yet (see docs/manual.md, "Leaders") — test
# data for the leaders/leader/reassign_leader commands. Guderian, Rommel,
# von Manstein and Rokossovsky are already assigned above; Konev is
# deliberately left unassigned to exercise that state.
[[leaders]]
name = "Heinz Guderian"
faction = "AX"
[leaders.stats]
political = 3
morale = 7
initiative = 9
administration = 5
mechanized = 9
infantry = 4
air = 2

[[leaders]]
