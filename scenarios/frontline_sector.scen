# Where each faction traces its supply connectivity back to (game::supply):
# a unit cut off from every source of its own is reported "cut off" by the
# `supply` command. No gameplay effect yet — that's a later slice. The
# German source doubles as the "Rear supply depot" victory hex below: taking
# it is worth points now and would also cut German supply once that lands.
[[supply_sources]]
faction = "SU"
x = 4
y = 0

[[supply_sources]]
faction = "AX"
x = 4
y = 7

# Scenario events: a message plus an optional morale/experience nudge to a
# faction's default, firing the moment that faction's turn reaches the
# scheduled turn. Testing values, not balanced.
[[events]]
turn = 1
faction = "AX"
message = "The assault opens with total surprise; German morale surges."
morale_delta = 5

[[events]]
turn = 4
faction = "SU"
message = "Stavka orders the line held at all costs; Soviet resolve stiffens."
morale_delta = 5

[[events]]
turn = 8
faction = "AX"
message = "Supply lines are stretched thin this far east; the advance loses momentum."
morale_delta = -5

# Scheduled unit movement: reinforcements step onto the map at a given turn
# (typically out of an offmap reserve box), withdrawals step off it
# (typically back into one).
[[reinforcements]]
unit = "11th Rifle Division"
turn = 3
location = { x = 4, y = 4 }

[[reinforcements]]
unit = "12th Rifle Division"
turn = 5
location = { x = 6, y = 4 }

[[reinforcements]]
unit = "3rd Panzer Division"
turn = 3
location = { x = 1, y = 6 }

[[withdrawals]]
unit = "2nd Infantry Division"
turn = 8
location = "GE Reserve"

# Win by holding the objectives at turn's end, by grinding down the enemy,
# or both; losing your own force costs points too. Testing values, not
# balanced.
[victory_conditions]
last_turn = 12
points_per_percent_enemy_destroyed = 1.5
points_per_percent_own_lost = 0.75

[[victory_conditions.hexes]]
x = 4
y = 4
name = "Rifle division crossroads"
points = 25

[[victory_conditions.hexes]]
x = 9
y = 2
name = "Ostrov road junction"
points = 50

[[victory_conditions.hexes]]
x = 4
y = 7
name = "Rear supply depot"
points = 35
