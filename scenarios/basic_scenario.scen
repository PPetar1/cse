name = "Basic scenario for development"
game_version = "0.1.0"
map = "maps/basic_map.map"

start_date = "1941-06-22"
turn_length = 7

# Fog of war: a faction only sees a hex if one of its own on-map units is
# within detection_range hexes of it. Absent entirely (as in
# frontline_sector.scen), every faction sees the whole board.
[fog_of_war]
detection_range = 3

# Movement points to enter a hex, per terrain; 0 = impassable. Terrains left
# out fall back to engine defaults (these values restate them explicitly).
[terrain_costs]
Plains = 1
Desert = 1
Urban = 1
Forest = 2
Hills = 2
Swamp = 3
Mountain = 3
Water = 0

# morale/experience: faction-wide defaults; units and single elements can
# override them (the most specific setting wins, absent everywhere = 50).
[[factions]]
faction_name = "Axis"
faction_tag = "AX"
morale = 75
experience = 65
[[factions]]
faction_name = "Soviet Union"
faction_tag = "SU"
morale = 45
experience = 35

# Players: who takes turns for each faction. Axis has two here, playing one
# after another (in this order) whenever it's Axis's turn — Soviet Union has
# none listed, so it gets a single default player named after the faction.
[[players]]
name = "Axis Player 1"
faction = "AX"
[[players]]
name = "Axis Player 2"
faction = "AX"

# mp: movement points per turn — leg formations low, motorized/armored high.
[[toe]]
name = "SU_inf_div_41a"
size = "Division"
mp = 16
start_date = "1941-01-01"
end_date = "1941-08-01"
[[toe.elements]]
name = "SU_inf_squad"
amount = 200
[[toe.elements]]
name = "SU_45mm_at_gun"
amount = 40
[[toe.elements]]
name = "SU_122mm_howitzer_M1938"
amount = 20

[[toe]]
name = "GE_pz_div_41"
size = "Division"
mp = 30
start_date = "1941-01-01"
end_date = "1941-10-01"
[[toe.elements]]
name = "GE_pz_g_squad"
amount = 200
[[toe.elements]]
name = "GE_pz_2"
amount = 20
[[toe.elements]]
name = "GE_pz_4"
amount = 30

# Air support (Phase 5, slice 1): joins a ground attack as extra firers for
# that one battle (game::orders::attack::air_support). mp = 0 since it's
# never ordered onto the map like a ground unit. range (Phase 5, slice 4,
# "airfields"): the wing is based on-map now (see its [[units]] entry
# below), and range caps how far in hexes air_support/interdict can reach
# from wherever it currently sits.
[[toe]]
name = "GE_stuka_wing"
size = "Regiment"
mp = 0
range = 9
start_date = "1941-01-01"
end_date = "1941-10-01"
[[toe.elements]]
name = "GE_stuka"
amount = 20

# Air superiority (Phase 5, slice 2) + interdiction (slice 3): a
# Fighter-class unit must interdict a hex (up to 3 at a time) before it's
# pulled into a battle there — see game::interdiction. range as above.
[[toe]]
name = "SU_fighter_regiment"
size = "Regiment"
mp = 0
range = 9
start_date = "1941-01-01"
end_date = "1941-10-01"
[[toe.elements]]
name = "SU_yak1"
amount = 20

# An element fights with its devices: each in-range device fires
# rate_of_fire shots per combat round. accuracy: chance a shot hits;
# soft_attack/hard_attack: how devastating a hit is vs unarmored/armored
# targets; vulnerability (element-level): how easily fire takes effect on
# it — armor for vehicles, exposure for the rest.
[[elements]]
name = "SU_inf_squad"
class = "Inf"
cv = 4
vulnerability = 100
[[elements.devices]]
name = "rifles_and_lmg"
accuracy = 20
range = 100
rate_of_fire = 3
soft_attack = 40
hard_attack = 0
[[elements.devices]]
name = "at_grenades"
accuracy = 15
range = 100
rate_of_fire = 1
soft_attack = 0
hard_attack = 10

[[elements]]
name = "SU_45mm_at_gun"
class = "AtGun"
cv = 0.2
vulnerability = 60
# Dual-purpose: same gun also engages air-domain targets (anti_air), at a
# far weaker air_attack value than its anti-tank punch.
anti_air = true
[[elements.devices]]
name = "45mm_m1937"
accuracy = 60
range = 300
rate_of_fire = 2
soft_attack = 15
hard_attack = 90
air_attack = 10

[[elements]]
name = "SU_122mm_howitzer_M1938"
class = "LightArt"
cv = 0.5
vulnerability = 70
[[elements.devices]]
name = "122mm_m1938"
accuracy = 5
range = 11000
rate_of_fire = 2
soft_attack = 100
hard_attack = 15

[[elements]]
name = "GE_pz_g_squad"
class = "MotInf"
cv = 4
vulnerability = 100
[[elements.devices]]
name = "rifles_and_mg34"
accuracy = 20
range = 100
rate_of_fire = 3
soft_attack = 40
hard_attack = 0
[[elements.devices]]
name = "at_grenades"
accuracy = 15
range = 100
rate_of_fire = 1
soft_attack = 0
hard_attack = 10

[[elements]]
name = "GE_pz_2"
class = "LightTank"
cv = 8
vulnerability = 40
[[elements.devices]]
name = "20mm_kwk30"
accuracy = 50
range = 600
rate_of_fire = 4
soft_attack = 30
hard_attack = 50
[[elements.devices]]
name = "mg34_coaxial"
accuracy = 30
range = 200
rate_of_fire = 6
soft_attack = 40
hard_attack = 0

[[elements]]
name = "GE_pz_4"
class = "MedTank"
cv = 12
vulnerability = 25
[[elements.devices]]
name = "75mm_kwk37"
accuracy = 60
range = 800
rate_of_fire = 2
soft_attack = 60
hard_attack = 70
[[elements.devices]]
name = "mg34_coaxial"
accuracy = 30
range = 200
rate_of_fire = 6
soft_attack = 40
hard_attack = 0

# A CAS aircraft (air-domain): engages ground targets normally, and air
# targets weakly via air_attack (rear gunner vs intercepting fighters).
# Only anti_air-flagged ground elements or enemy fighters can hit it back —
# ordinary ground fire can't touch an air-domain target at all. range is
# set above the highest range band so it fires in every round of whatever
# battle it joins, the same trick the long-range artillery elements above
# already use.
[[elements]]
name = "GE_stuka"
class = "GroundAttack"
cv = 5
vulnerability = 50
[[elements.devices]]
name = "sc250_bombs"
accuracy = 25
range = 3000
rate_of_fire = 1
soft_attack = 80
hard_attack = 40
air_attack = 10

# An air-superiority fighter: air-domain, but unlike GroundAttack it can
# only ever engage other air-domain targets (see ElementClass::Fighter).
[[elements]]
name = "SU_yak1"
class = "Fighter"
cv = 6
vulnerability = 45
[[elements.devices]]
name = "shvak_cannon"
accuracy = 30
range = 3000
rate_of_fire = 2
soft_attack = 0
hard_attack = 0
air_attack = 60

# Inherits the Soviet faction defaults (45/35), except the gun crews.
[[units]]
name = "101st Infantry division"
toe = "SU_inf_div_41a"
faction = "SU"
location = { x = 3, y = 3 }
leader = "Georgy Zhukov"

[[units.elements]]
name = "SU_122mm_howitzer_M1938"
experience = 55

[[units]]
name = "102nd Infantry division"
toe = "SU_inf_div_41a"
faction = "SU"
location = { x = 6, y = 3 }

[[units]]
name = "103rd Infantry division"
toe = "SU_inf_div_41a"
faction = "SU"
location = { x = 8, y = 5 }

[[units]]
name = "104th Infantry division"
toe = "SU_inf_div_41a"
faction = "SU"
location = "SU Reserve"

# Airfield: based on-map at the Soviet supply source, in range (9 hexes)
# of the frontline. Must interdict a hex before it joins a battle there.
[[units]]
name = "1st Fighter Regiment"
toe = "SU_fighter_regiment"
faction = "SU"
location = { x = 0, y = 0 }

[[units]]
name = "4th Panzer Division"
toe = "GE_pz_div_41"
faction = "AX"
location = { x = 3, y = 4 }
morale = 80
experience = 70
leader = "Erwin Rommel"

[[units]]
name = "5th Panzer Division"
toe = "GE_pz_div_41"
faction = "AX"
location = { x = 2, y = 4 }
morale = 80
experience = 70
leader = "Heinz Guderian"

[[units]]
name = "6th Panzer Division"
toe = "GE_pz_div_41"
faction = "AX"
location = { x = 4, y = 6 }
morale = 80
experience = 70

[[units]]
name = "10th Panzer Division"
toe = "GE_pz_div_41"
faction = "AX"
location = "GE Reserve"
morale = 80
experience = 70

# Airfield: based on-map at the German supply source, in range (9 hexes)
# of the frontline. mp = 0, so it never moves on its own.
[[units]]
name = "1st Stuka Wing"
toe = "GE_stuka_wing"
faction = "AX"
location = { x = 9, y = 7 }
morale = 80
experience = 70

# Leaders: no gameplay effect yet (see docs/manual.md, "Leaders") — this is
# test data for the leaders/leader/reassign_leader commands. Rommel and
# Guderian are already assigned above; Rokossovsky is deliberately left
# unassigned to exercise that state.
[[leaders]]
name = "Erwin Rommel"
faction = "AX"
[leaders.stats]
political = 4
morale = 8
initiative = 9
administration = 4
mechanized = 8
infantry = 5
air = 2

[[leaders]]
name = "Heinz Guderian"
faction = "AX"
[leaders.stats]
political = 3
morale = 7
initiative = 9
administration = 5
mechanized = 9
infantry = 4
air = 2

[[leaders]]
name = "Georgy Zhukov"
faction = "SU"
[leaders.stats]
political = 7
morale = 8
initiative = 8
administration = 6
mechanized = 5
infantry = 7
air = 3

[[leaders]]
name = "Konstantin Rokossovsky"
faction = "SU"
[leaders.stats]
political = 5
morale = 7
initiative = 8
administration = 6
mechanized = 6
infantry = 7
air = 2

# Where each faction traces its supply connectivity back to (game::supply):
# the `supply` command reports any unit that can't reach one of these as
# "cut off". No gameplay effect yet — that's a later slice.
[[supply_sources]]
faction = "SU"
x = 0
y = 0

[[supply_sources]]
faction = "AX"
x = 9
y = 7

# A message plus an optional morale/experience nudge to a faction's default,
# firing the moment that faction's turn reaches the scheduled turn. Testing
# values, not balanced.
[[events]]
turn = 1
faction = "AX"
message = "Opening barrage: German morale is high as the offensive begins."
morale_delta = 5

[[events]]
turn = 5
faction = "SU"
message = "Stavka orders reserves forward; Soviet resolve stiffens."
morale_delta = 10
experience_delta = 5

# Scheduled unit movement: reinforcements step onto the map at a given turn
# (typically out of an offmap reserve box), withdrawals step off it (typically
# back into one). Testing values, not balanced.
[[reinforcements]]
unit = "104th Infantry division"
turn = 3
location = { x = 6, y = 4 }

[[reinforcements]]
unit = "10th Panzer Division"
turn = 4
location = { x = 3, y = 5 }

[[withdrawals]]
unit = "103rd Infantry division"
turn = 7
location = "SU Reserve"

# Win by holding the objective hexes at turn's end, by grinding down the
# enemy, or both; losing your own force costs points too. Testing values,
# not balanced.
[victory_conditions]
last_turn = 10
points_per_percent_enemy_destroyed = 1.0
points_per_percent_own_lost = 0.5

[[victory_conditions.hexes]]
x = 3
y = 3
name = "Central crossroads"
points = 30

[[victory_conditions.hexes]]
x = 9
y = 2
name = "City of Ostrov"
points = 50

[[victory_conditions.hexes]]
x = 0
y = 0
name = "Northern depot"
points = 20

