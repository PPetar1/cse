name = "Basic scenario for development"
game_version = "0.1.0"
map = "maps/basic_map.map"

start_date = "1941-06-22"
turn_length = 7

# morale/experience: faction-wide defaults; units and single elements can
# override them (the most specific setting wins, absent everywhere = 50).
[[players]]
faction_name = "Axis"
faction_tag = "AX"
morale = 75
experience = 65
[[players]]
faction_name = "Soviet Union"
faction_tag = "SU"
morale = 45
experience = 35

[[toe]]
name = "SU_inf_div_41a"
size = "Division"
start_date = "1941-01-01"
end_date = "1941-08-01"
[[toe.elements]]
name = "SU_inf_squad"
amount = 200
[[toe.elements]]
name = "SU_45mm_at_gun"
amount = 40
[[toe.elements]]
name = "SU_122mm_howitzer_M1938"
amount = 20

[[toe]]
name = "GE_pz_div_41"
size = "Division"
start_date = "1941-01-01"
end_date = "1941-10-01"
[[toe.elements]]
name = "GE_pz_g_squad"
amount = 200
[[toe.elements]]
name = "GE_pz_2"
amount = 20
[[toe.elements]]
name = "GE_pz_4"
amount = 30

# soft_attack/hard_attack: fire strength vs unarmored/armored targets;
# vulnerability: how easily fire takes effect on the element (armor for
# vehicles, exposure for the rest).
[[elements]]
name = "SU_inf_squad"
#[[device]]
class = "Inf"
cv = 4
accuracy = 20
range = 100
soft_attack = 100
hard_attack = 5
vulnerability = 100

